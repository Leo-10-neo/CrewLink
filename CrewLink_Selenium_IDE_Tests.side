        {
          "id": "7f36c5da-22e1-4fc5-8978-79321f82a05d",
          "comment": "Enter Username pari",
          "command": "executeScript",
          "target": "if(window.__type){window.__type(\"id=reg-username\",\"pari\");}else{var sel=\"id=reg-username\";var val=\"pari\";var el;if(sel.startsWith(\"id=\"))el=document.getElementById(sel.substring(3));else if(sel.startsWith(\"css=\"))el=document.querySelector(sel.substring(4));else if(sel.startsWith(\"name=\"))el=document.querySelector('[name=\"'+sel.substring(5)+'\"]');else if(sel.startsWith(\"//\")||sel.startsWith(\"xpath=\")){var xp=sel.replace(/^xpath=/,\"\");el=document.evaluate(xp,document,null,XPathResult.FIRST_ORDERED_NODE_TYPE,null).singleNodeValue;}else{el=document.querySelector(sel)||document.getElementById(sel);}if(el){var proto=(el instanceof HTMLTextAreaElement)?window.HTMLTextAreaElement.prototype:window.HTMLInputElement.prototype;var s=Object.getOwnPropertyDescriptor(proto,\"value\")?.set;if(s){s.call(el,val);}else{el.value=val;}el.dispatchEvent(new Event(\"input\",{bubbles:true}));el.dispatchEvent(new Event(\"change\",{bubbles:true}));el.dispatchEvent(new Event(\"blur\",{bubbles:true}));}}",
          "targets": [
            [
              "if(window.__type){window.__type(\"id=reg-username\",\"pari\");}else{var sel=\"id=reg-username\";var val=\"pari\";var el;if(sel.startsWith(\"id=\"))el=document.getElementById(sel.substring(3));else if(sel.startsWith(\"css=\"))el=document.querySelector(sel.substring(4));else if(sel.startsWith(\"name=\"))el=document.querySelector('[name=\"'+sel.substring(5)+'\"]');else if(sel.startsWith(\"//\")||sel.startsWith(\"xpath=\")){var xp=sel.replace(/^xpath=/,\"\");el=document.evaluate(xp,document,null,XPathResult.FIRST_ORDERED_NODE_TYPE,null).singleNodeValue;}else{el=document.querySelector(sel)||document.getElementById(sel);}if(el){var proto=(el instanceof HTMLTextAreaElement)?window.HTMLTextAreaElement.prototype:window.HTMLInputElement.prototype;var s=Object.getOwnPropertyDescriptor(proto,\"value\")?.set;if(s){s.call(el,val);}else{el.value=val;}el.dispatchEvent(new Event(\"input\",{bubbles:true}));el.dispatchEvent(new Event(\"change\",{bubbles:true}));el.dispatchEvent(new Event(\"blur\",{bubbles:true}));}}",
              "id"
            ]
          ],
          "value": ""
        },
