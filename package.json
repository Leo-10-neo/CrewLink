    "android:build": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleDebug --no-daemon && node -e \"const fs=require('fs'), path=require('path'), os=require('os'), src=path.join(process.cwd(), 'app/build/outputs/apk/debug/app-debug.apk'); fs.copyFileSync(src, '../CrewLink.apk'); fs.copyFileSync(src, '../CrewLink-debug.apk'); const dsk=path.join(os.homedir(), 'OneDrive/Desktop/CrewLink.apk'); if(fs.existsSync(path.dirname(dsk))) fs.copyFileSync(src, dsk);\""
  },
